{
  "schema_version": "clifft-bench/campaign/v1",
  "id": "current-tools-v1",
  "title": "Current single-core Clifft and SymFT comparison",
  "hardware_epoch": "aws-m7a-xlarge-ubuntu2404-v1",
  "runs": [
    {
      "id": "clifft-0.8.0",
      "run_manifest": "clifft-0.8.0.run.json"
    },
    {
      "id": "clifft-0.9.0",
      "run_manifest": "clifft-0.9.0.run.json"
    },
    {
      "id": "symft-single",
      "run_manifest": "symft-single.run.json"
    },
    {
      "id": "symft-batch-2048",
      "run_manifest": "symft-batch-2048.run.json"
    },
    {
      "id": "symft-batch-32",
      "run_manifest": "symft-batch-32.run.json"
    }
  ],
  "reference_host": {
    "provider": "aws",
    "instance_type": "m7a.xlarge",
    "architecture": "x86_64",
    "os_id": "ubuntu",
    "os_version": "24.04"
  },
  "collection": {
    "placements": 3,
    "replicas_per_placement": 1,
    "run_timeout_minutes": 90,
    "memory_limit_gib": 12
  },
  "environments": [
    {
      "id": "clifft-0.8.0",
      "python_executable_env": "CLIFFT_BENCH_CLIFFT_0_8_0_PYTHON",
      "requirements": "../../environments/clifft-0.8.0.txt",
      "import_modules": ["clifft"]
    },
    {
      "id": "clifft-0.9.0",
      "python_executable_env": "CLIFFT_BENCH_CLIFFT_0_9_0_PYTHON",
      "requirements": "../../environments/clifft-0.9.0.txt",
      "import_modules": ["clifft"]
    },
    {
      "id": "symft-0.1.0-9ec5790",
      "python_executable_env": "CLIFFT_BENCH_SYMFT_9EC5790_PYTHON",
      "requirements": "../../environments/symft-0.1.0-9ec5790.txt",
      "import_modules": ["symft"],
      "install_environment": {
        "SYMFT_PY_NATIVE": "1",
        "SYMFT_PY_ENABLE_CUDA": "0"
      }
    }
  ],
  "comparisons": [
    {
      "id": "clifft-0.9-vs-0.8",
      "baseline_run": "clifft-0.8.0",
      "candidate_runs": [
        "clifft-0.9.0"
      ]
    },
    {
      "id": "current-tools-vs-clifft-0.9",
      "baseline_run": "clifft-0.9.0",
      "candidate_runs": [
        "symft-single",
        "symft-batch-2048",
        "symft-batch-32"
      ]
    }
  ]
}
