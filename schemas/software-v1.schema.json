{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitaryfoundation.github.io/clifft-bench/schemas/software-v1.schema.json",
  "title": "clifft-bench software manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_version", "implementations"],
  "properties": {
    "schema_version": {"const": "clifft-bench/software/v1"},
    "suite_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "adapter", "distribution", "version", "commit_sha",
          "commit_datetime", "release_datetime", "source_url", "dependency_distributions",
          "build"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "name": {"type": "string", "minLength": 1},
          "adapter": {"enum": ["clifft", "symft", "fixture"]},
          "distribution": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "display_version": {"type": "string", "minLength": 1},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "commit_datetime": {"type": "string", "format": "date-time"},
          "release_datetime": {"type": ["string", "null"], "format": "date-time"},
          "source_url": {"type": "string", "format": "uri"},
          "source_tag": {"type": "string", "minLength": 1},
          "dependency_distributions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "python_executable_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirements", "import_modules"],
            "properties": {
              "requirements": {"type": "string", "minLength": 1},
              "import_modules": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "install_environment": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              }
            }
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["precision", "compiler_flags", "features"],
            "properties": {
              "precision": {"type": "string", "minLength": 1},
              "compiler_flags": {"type": "array", "items": {"type": "string"}},
              "features": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
