{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitaryfoundation.github.io/clifft-bench/schemas/qv-result-v1.schema.json",
  "title": "clifft-bench QV multicore raw result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "run", "runner", "cases"],
  "properties": {
    "schema_version": {"const": "clifft-bench/qv-result/v1"},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "classification", "hardware_epoch", "manifest", "manifest_sha256",
        "circuit_generator_dependencies"
      ],
      "properties": {
        "id": {"type": "string"},
        "classification": {"enum": ["smoke", "exploratory", "official"]},
        "hardware_epoch": {"type": "string"},
        "manifest": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "circuit_generator_dependencies": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "profile_id", "execution_id", "started_at", "finished_at",
        "placement", "replica", "schedule_policy", "workflow"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "profile_id": {"type": "string"},
        "execution_id": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "placement": {"type": "integer", "minimum": 1},
        "replica": {"type": "integer", "minimum": 1},
        "schedule_policy": {"const": "serial-alternating-forward-reverse"},
        "workflow": {"type": "object"}
      }
    },
    "runner": {"$ref": "#/$defs/runner"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "cloud": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "provider", "instance_id", "instance_type", "image_id", "region",
        "availability_zone", "lifecycle", "boot_id"
      ],
      "properties": {
        "provider": {"type": "string"},
        "instance_id": {"type": "string"},
        "instance_type": {"type": "string"},
        "image_id": {"type": "string"},
        "region": {"type": "string"},
        "availability_zone": {"type": "string"},
        "lifecycle": {"type": "string"},
        "boot_id": {"type": "string"}
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "hostname", "os", "os_release", "kernel_version", "machine", "python",
        "python_compiler", "cpu_model", "physical_cores", "logical_cpus",
        "allowed_logical_cpus", "memory_bytes", "load_average_at_start",
        "thread_environment", "accelerator", "cloud", "suite_source"
      ],
      "properties": {
        "hostname": {"type": "string"},
        "os": {"type": "string"},
        "os_release": {"type": "string"},
        "kernel_version": {"type": "string"},
        "machine": {"type": "string"},
        "python": {"type": "string"},
        "python_compiler": {"type": "string"},
        "cpu_model": {"type": "string"},
        "physical_cores": {"type": ["integer", "null"]},
        "logical_cpus": {"type": ["integer", "null"]},
        "allowed_logical_cpus": {"type": ["array", "null"], "items": {"type": "integer"}},
        "memory_bytes": {"type": ["integer", "null"]},
        "load_average_at_start": {"type": ["array", "null"], "items": {"type": "number"}},
        "thread_environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "accelerator": {"type": ["object", "null"]},
        "cloud": {"$ref": "#/$defs/cloud"},
        "suite_source": {
          "type": "object",
          "required": ["commit", "dirty"],
          "properties": {
            "commit": {"$ref": "#/$defs/nullableString"},
            "dirty": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "sequence_index", "status", "phase", "simulator", "circuit",
        "threads", "timing", "peak_rss_bytes", "runtime_metadata", "error"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "sequence_index": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "success", "error", "timeout", "interrupted"]},
        "phase": {"enum": ["current-tools", "clifft-scaling", "historical-anchor"]},
        "simulator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id", "name", "version", "distribution", "expected_distribution_version",
            "commit_sha", "source_url", "adapter", "environment_id", "dependencies"
          ],
          "properties": {
            "run_id": {"type": "string"},
            "name": {"type": "string"},
            "version": {"type": "string"},
            "distribution": {"type": "string"},
            "expected_distribution_version": {"type": ["string", "null"]},
            "commit_sha": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              ]
            },
            "source_url": {"type": "string", "format": "uri"},
            "adapter": {"type": "string"},
            "environment_id": {"type": "string"},
            "dependencies": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "circuit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "qubits", "depth", "seed", "basis_gates", "path", "sha256"],
          "properties": {
            "family": {"const": "quantum-volume"},
            "qubits": {"type": "integer", "minimum": 2},
            "depth": {"type": "integer", "minimum": 2},
            "seed": {"type": "integer", "minimum": 0},
            "basis_gates": {"type": "array", "items": {"type": "string"}},
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "effective", "cpu_set", "policy"],
          "properties": {
            "requested": {"type": "integer", "minimum": 1},
            "effective": {"type": ["integer", "null"], "minimum": 1},
            "cpu_set": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "policy": {"const": "one-logical-cpu-per-physical-core"}
          }
        },
        "timing": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["execution_seconds", "compile_seconds", "sample_seconds", "timed_region"],
              "properties": {
                "execution_seconds": {"type": "number", "minimum": 0},
                "compile_seconds": {"type": "number", "minimum": 0},
                "sample_seconds": {"type": "number", "minimum": 0},
                "timed_region": {"const": "original-clifft-paper-qv-v1"}
              }
            }
          ]
        },
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "runtime_metadata": {"type": "object"},
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "message"],
              "properties": {
                "type": {"type": "string"},
                "message": {"type": "string"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "success"}}},
          "then": {
            "properties": {
              "timing": {"type": "object"},
              "peak_rss_bytes": {"type": "integer"},
              "error": {"type": "null"},
              "threads": {
                "properties": {"cpu_set": {"minItems": 1}}
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["error", "timeout", "interrupted"]}}},
          "then": {"properties": {"error": {"type": "object"}}}
        }
      ]
    }
  }
}
