{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitaryfoundation.github.io/clifft-bench/schemas/qv-campaign-v1.schema.json",
  "title": "clifft-bench QV multicore campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "title", "classification", "hardware_epoch",
    "reference_host", "collection", "circuit", "environments", "runs"
  ],
  "properties": {
    "schema_version": {"const": "clifft-bench/qv-campaign/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "classification": {"enum": ["smoke", "exploratory", "official"]},
    "hardware_epoch": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "reference_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "instance_type", "architecture", "os_id", "os_version",
        "physical_cores", "logical_cpus", "cpu_policy"
      ],
      "properties": {
        "provider": {"const": "aws"},
        "instance_type": {"type": "string", "minLength": 1},
        "architecture": {"const": "x86_64"},
        "os_id": {"const": "ubuntu"},
        "os_version": {"const": "24.04"},
        "physical_cores": {"type": "integer", "minimum": 1},
        "logical_cpus": {"type": "integer", "minimum": 1},
        "cpu_policy": {"const": "one-logical-cpu-per-physical-core"}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placements", "replicas_per_placement", "run_timeout_minutes",
        "case_timeout_seconds", "memory_limit_gib"
      ],
      "properties": {
        "placements": {"type": "integer", "minimum": 1},
        "replicas_per_placement": {"type": "integer", "minimum": 1},
        "run_timeout_minutes": {"type": "integer", "minimum": 1},
        "case_timeout_seconds": {"type": "integer", "minimum": 1},
        "memory_limit_gib": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family", "depth", "basis_gates", "qubits", "seeds",
        "generator_environment", "source"
      ],
      "properties": {
        "family": {"const": "quantum-volume"},
        "depth": {"const": "width"},
        "basis_gates": {
          "type": "array",
          "prefixItems": [{"const": "cx"}, {"const": "u3"}],
          "items": false
        },
        "qubits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 2}
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
        },
        "generator_environment": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path", "commit"],
          "properties": {
            "repository": {"type": "string", "format": "uri"},
            "path": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirements", "import_modules"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "requirements": {"type": "string", "minLength": 1},
          "import_modules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}
          },
          "install_environment": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "pip_config_settings": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "phase", "name", "version", "distribution",
          "expected_distribution_version", "commit_sha", "source_url",
          "adapter", "environment_id", "threads", "qubits"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "phase": {"enum": ["current-tools", "clifft-scaling", "historical-anchor"]},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "distribution": {"type": "string", "minLength": 1},
          "expected_distribution_version": {"type": ["string", "null"]},
          "commit_sha": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            ]
          },
          "source_url": {"type": "string", "format": "uri"},
          "adapter": {"enum": ["clifft", "qiskit", "qulacs", "qsim", "qrack"]},
          "environment_id": {"type": "string", "minLength": 1},
          "threads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "qubits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 2}
          }
        }
      }
    }
  }
}
